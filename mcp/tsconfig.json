{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022"],
    // Only the bare "zod" alias (so @devdigest/shared resolves to this package's
    // zod). A "zod/*" alias, as in reviewer-core, bypasses zod's exports map for
    // the SDK's zod/v3 + zod/v4 imports and makes tsc hang on registerTool.
    "paths": {
      "@devdigest/shared": ["../server/src/vendor/shared/index.ts"],
      "@devdigest/shared/*": ["../server/src/vendor/shared/*"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
